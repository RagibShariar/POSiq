generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── BUSINESS ───────────────────────────────────────
model Business {
  id        String    @id @default(uuid())
  name      String
  type      String // retail, restaurant, salon, pharmacy
  email     String    @unique
  phone     String?
  address   String?
  logo      String?
  currency  String    @default("BDT")
  timezone  String    @default("Asia/Dhaka")
  settings  Json?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  branches     Branch[]
  users        User[]
  categories   Category[]
  products     Product[]
  subscription Subscription?
}

// ─── BRANCH ─────────────────────────────────────────
model Branch {
  id           String    @id @default(uuid())
  businessId   String
  name         String
  code         String // "GUL-01"
  address      String?
  phone        String?
  isActive     Boolean   @default(true)
  isMainBranch Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  business  Business       @relation(fields: [businessId], references: [id])
  staff     UserBranch[]
  inventory Inventory[]
  orders    Order[]
  registers CashRegister[]

  @@unique([businessId, code])
  @@index([businessId])
}

// ─── USER ────────────────────────────────────────────
model User {
  id          String    @id @default(uuid())
  businessId  String? // null = Super Admin
  name        String
  email       String    @unique
  password    String
  role        Role      @default(CASHIER)
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  business Business?    @relation(fields: [businessId], references: [id])
  branches UserBranch[]
  orders   Order[]

  @@index([businessId])
}

model UserBranch {
  id         String   @id @default(uuid())
  userId     String
  branchId   String
  assignedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])

  @@unique([userId, branchId])
}

enum Role {
  SUPER_ADMIN
  OWNER
  MANAGER
  CASHIER
}

// ─── CATEGORY ────────────────────────────────────────
model Category {
  id          String    @id @default(uuid())
  businessId  String
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  business Business          @relation(fields: [businessId], references: [id])
  products ProductCategory[]

  @@index([businessId])
}

// ─── PRODUCT (Business-scoped catalog) ───────────────
model Product {
  id                String    @id @default(uuid())
  businessId        String
  name              String
  sku               String
  barcode           String?
  description       String?
  imageUrl          String?
  price             Decimal
  costPrice         Decimal
  unit              String    @default("pcs")
  lowStockThreshold Int       @default(10)
  hasVariations     Boolean   @default(false)
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  business       Business               @relation(fields: [businessId], references: [id])
  categories     ProductCategory[]
  inventory      Inventory[]
  orderItems     OrderItem[]
  variations     ProductVariation[]
  modifierGroups ProductModifierGroup[]

  @@unique([businessId, sku])
  @@index([businessId])
  @@index([businessId, barcode])
}

// Join table — a product can belong to multiple categories.
model ProductCategory {
  productId  String
  categoryId String

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
}

// ─── INVENTORY (Branch-scoped stock) ─────────────────
model Inventory {
  id         String   @id @default(uuid())
  businessId String
  branchId   String
  productId  String
  stock      Int      @default(0)
  updatedAt  DateTime @updatedAt

  branch  Branch         @relation(fields: [branchId], references: [id])
  product Product        @relation(fields: [productId], references: [id])
  logs    InventoryLog[]

  @@unique([branchId, productId])
  @@index([businessId])
}

model InventoryLog {
  id          String        @id @default(uuid())
  inventoryId String
  branchId    String
  productId   String
  type        InventoryType
  quantity    Int
  note        String?
  createdBy   String
  createdAt   DateTime      @default(now())

  inventory Inventory @relation(fields: [inventoryId], references: [id])

  @@index([inventoryId])
}

enum InventoryType {
  RESTOCK
  SALE
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
}

// ─── CASH REGISTER ───────────────────────────────────
model CashRegister {
  id             String         @id @default(uuid())
  branchId       String
  openedBy       String
  closedBy       String?
  openingBalance Decimal        @default(0)
  closingBalance Decimal?
  status         RegisterStatus @default(OPEN)
  openedAt       DateTime       @default(now())
  closedAt       DateTime?

  branch Branch  @relation(fields: [branchId], references: [id])
  orders Order[]

  @@index([branchId])
}

enum RegisterStatus {
  OPEN
  CLOSED
}

// ─── ORDER ───────────────────────────────────────────
model Order {
  id             String        @id @default(uuid())
  businessId     String
  branchId       String
  registerId     String?
  cashierId      String
  orderNumber    String // "ORD-2026-00123"
  customerName   String?
  customerPhone  String?
  subtotal       Decimal
  discountAmount Decimal       @default(0)
  taxAmount      Decimal       @default(0)
  totalAmount    Decimal
  paymentMethod  PaymentMethod
  paymentRef     String?
  status         OrderStatus   @default(COMPLETED)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  branch   Branch         @relation(fields: [branchId], references: [id])
  cashier  User           @relation(fields: [cashierId], references: [id])
  register CashRegister?  @relation(fields: [registerId], references: [id])
  items    OrderItem[]
  payments OrderPayment[]
  refunds  Refund[]

  @@unique([businessId, orderNumber])
  @@index([businessId, createdAt])
  @@index([branchId, createdAt])
}

// One row per tender — supports split payments (e.g. half cash, half card).
model OrderPayment {
  id          String        @id @default(uuid())
  orderId     String
  method      PaymentMethod
  amount      Decimal
  reference   String? // card approval no. / bKash TrxID
  tendered    Decimal? // cash handed over by the customer
  changeGiven Decimal? // cash returned
  createdAt   DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
}

model OrderItem {
  id            String  @id @default(uuid())
  orderId       String
  productId     String
  productName   String // snapshot at time of sale
  variationId   String? // scalar snapshot — variation may later be deleted
  variationName String? // snapshot at time of sale
  unitPrice     Decimal // snapshot at time of sale (includes variation price)
  quantity      Int
  discount      Decimal @default(0)
  subtotal      Decimal // (unitPrice + modifiers) * qty - discount
  specialNote   String?

  order     Order               @relation(fields: [orderId], references: [id])
  product   Product             @relation(fields: [productId], references: [id])
  modifiers OrderItemModifier[]

  @@index([orderId])
  @@index([productId])
}

// Snapshot of a modifier selected on an order line (e.g. "Extra Shot ×1").
model OrderItemModifier {
  id             String  @id @default(uuid())
  orderItemId    String
  modifierItemId String // scalar snapshot — modifier may later be deleted
  name           String
  price          Decimal @default(0)
  quantity       Int     @default(1)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
}

enum PaymentMethod {
  CASH
  CARD // legacy generic card (kept for old orders)
  MOBILE_BANKING // legacy generic MFS (kept for old orders)
  MIXED // split-payment marker
  DUE
  COMPLIMENT
  VISA
  AMEX
  MASTERCARD
  BKASH
  NAGAD
  ROCKET
  FOODPANDA
  FOODI
  PATHAO
  OTHER
}

enum OrderStatus {
  COMPLETED
  REFUNDED
  PARTIALLY_REFUNDED
  VOIDED
}

// ─── REFUND ──────────────────────────────────────────
model Refund {
  id          String        @id @default(uuid())
  orderId     String
  branchId    String
  processedBy String
  amount      Decimal
  reason      String?
  method      PaymentMethod
  createdAt   DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
}

// ─── SUBSCRIPTION ────────────────────────────────────
model Subscription {
  id                 String             @id @default(uuid())
  businessId         String             @unique
  plan               PlanType           @default(FREE)
  status             SubscriptionStatus @default(ACTIVE)
  aiQueryLimit       Int                @default(50)
  aiQueryUsed        Int                @default(0)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  business Business @relation(fields: [businessId], references: [id])
}

enum PlanType {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  PAST_DUE
}

// ─── BILLING RECORD (plan change history / invoices) ─
model BillingRecord {
  id          String   @id @default(uuid())
  businessId  String
  plan        PlanType
  amount      Decimal
  currency    String   @default("BDT")
  periodStart DateTime
  periodEnd   DateTime
  note        String?
  createdAt   DateTime @default(now())

  @@index([businessId, createdAt])
}

// ─── AI QUERY LOG ────────────────────────────────────
model AiQueryLog {
  id         String   @id @default(uuid())
  businessId String
  branchId   String?
  userId     String
  question   String
  response   String
  tokensUsed Int
  costUsd    Decimal
  createdAt  DateTime @default(now())

  @@index([businessId, createdAt])
}

// ─── REFRESH TOKEN (JWT rotation) ────────────────────
model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─── PASSWORD RESET TOKEN ────────────────────────────
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ─── PRODUCT VARIATIONS & MODIFIERS ──────────────────

// Size/flavor variants of a product (e.g. "Regular" ৳250, "Large" ৳350).
model ProductVariation {
  id         String    @id @default(uuid())
  productId  String
  businessId String
  name       String
  price      Decimal
  costPrice  Decimal?
  isDefault  Boolean   @default(false)
  isActive   Boolean   @default(true)
  sortOrder  Int       @default(0)
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([businessId])
}

enum ModifierGroupType {
  ADDON
  SIDE_ITEM
  COOKING_INSTRUCTION
}

// A group of modifiers, e.g. "Drinks Add Ons", "Cooking Instructions".
model ModifierGroup {
  id         String            @id @default(uuid())
  businessId String
  name       String
  type       ModifierGroupType @default(ADDON)
  minSelect  Int               @default(0)
  maxSelect  Int               @default(10)
  isActive   Boolean           @default(true)
  createdAt  DateTime          @default(now())
  deletedAt  DateTime?

  items        ModifierItem[]
  productLinks ProductModifierGroup[]

  @@index([businessId])
}

// Individual modifier option (e.g. "Extra Shot" +৳75).
model ModifierItem {
  id         String   @id @default(uuid())
  groupId    String
  businessId String
  name       String
  price      Decimal  @default(0)
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  group ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([businessId])
}

// Links modifier groups to the products they apply to.
model ProductModifierGroup {
  productId       String
  modifierGroupId String
  isRequired      Boolean @default(false)
  sortOrder       Int     @default(0)

  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  modifierGroup ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@id([productId, modifierGroupId])
  @@index([modifierGroupId])
}

# Server
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:3000

# Database (PostgreSQL). DIRECT_URL is the non-pooled connection used by
# prisma migrate (same as DATABASE_URL if you're not behind a pooler).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smart_pos?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/smart_pos?schema=public"

# JWT
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AI Agent — provider: "gemini" (free tier) or "claude". Leave empty to
# auto-pick: Gemini if GEMINI_API_KEY is set, else Claude.
AI_PROVIDER=

# Gemini (free: 1,500 req/day) — get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=

# Claude (paid) — get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
AI_MODEL=
